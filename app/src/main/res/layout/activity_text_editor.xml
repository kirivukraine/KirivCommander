<?xml version="1.0" encoding="utf-8"?>
<!-- activity_text_editor.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"/>
    </com.google.android.material.appbar.AppBarLayout>

    <TextView
        android:id="@+id/readOnlyBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warning_bg"
        android:gravity="center"
        android:padding="4dp"
        android:text="Лише для читання"
        android:textColor="@color/warning_text"
        android:textSize="12sp"
        android:visibility="gone"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:visibility="gone"/>

    <!-- Панель пошуку -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Знайти..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"/>

        <TextView
            android:id="@+id/searchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOutline"/>

        <ImageButton
            android:id="@+id/btnFindPrev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Попереднє"
            android:src="@drawable/ic_arrow_up"/>

        <ImageButton
            android:id="@+id/btnFindNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Наступне"
            android:src="@drawable/ic_arrow_down"/>

        <ImageButton
            android:id="@+id/btnCloseSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Закрити"
            android:src="@drawable/ic_close"/>

    </LinearLayout>

    <EditText
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurface"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:scrollbars="vertical"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:text="Рядків: 1  |  UTF-8"
        android:textColor="?attr/colorOutline"
        android:textSize="11sp"/>

</LinearLayout>
